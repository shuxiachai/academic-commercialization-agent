.env
.venv/
__pycache__/
*.pyc
.DS_Store
start.bat
# Per-run outputs may contain unpublished paper content and stay local. The two
# aggregate benchmark tables contain only the public, curated topic set and are
# tracked because README performance claims and their contract test derive from
# them; ignoring the evidence made those claims unverifiable in a fresh clone.
!outputs/
outputs/*
!outputs/benchmark/
outputs/benchmark/*
!outputs/benchmark/benchmark_summary.csv
!outputs/benchmark/benchmark_stability.csv
commercialization_report.md
!examples/**/commercialization_report.md
dist/
*.egg-info/
*.log
.coverage
htmlcov/
# The real-browser smoke keeps a screenshot only when it fails. CI uploads it
# before the workspace disappears; local failures must not dirty the project.
output/playwright/
# Personal write-up. Its own private repo (academic-agent-notes) lives in
# notes/ — this repo is public and that file is a first-person job-search
# narrative, not project documentation. Kept under the working tree rather
# than beside it so a backup covers both, and ignored here so the two
# repositories never see each other's files.
notes/
简历项目说明.md

# Tooling scratch space — worktrees here are separate git repos
.claude/
